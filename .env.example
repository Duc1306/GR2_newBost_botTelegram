# ===== DATABASE CONFIGURATION =====
MONGO_URI=mongodb://localhost:27017
DB_NAME=newsbot

# ===== TELEGRAM CONFIGURATION =====
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=
TELEGRAM_BOT_TOKEN=

# Số lượng message lấy mỗi lần (mặc định: 200)
TELEGRAM_FETCH_LIMIT=200

# Danh sách kênh Telegram (phân cách bằng ;)
TELEGRAM_CHANNELS=examplechannel1;examplechannel2

# ===== TWITTER CONFIGURATION =====

# CÁCH 1: Chỉ cần Bearer Token (ĐƠN GIẢN NHẤT - KHUYÊN DÙNG)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# CÁCH 2: OAuth 1.0a (Nếu không dùng Bearer Token)
# TWITTER_API_KEY=your_api_key
# TWITTER_API_SECRET=your_api_secret
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_SECRET=your_access_secret

# Số lượng tweets lấy mỗi lần (mặc định: 100)
TWITTER_FETCH_LIMIT=100

# ===== TWITTER SOURCES (@ = user, # = hashtag) =====
# ⚠️ QUAN TRỌNG: Chỉ uncomment 5-15 sources để tránh rate limit!
# Twitter API Free tier: 450 requests/15 phút
# Mỗi source = 1 request, nên giới hạn sources

# 🎯 RECOMMENDED: 10 sources cân bằng (Uncomment để dùng)
TWITTER_SOURCES=@BBCBreaking;@Reuters;@business;@TechCrunch;@VNExpress;@OpenAI;#Technology;#AI;#Business;#Vietnam

# 📰 Hoặc chọn theo chủ đề (Comment dòng trên, uncomment 1 dòng dưới):

# TIN TỨC TỔNG HỢP (General News)
# TWITTER_SOURCES=@BBCBreaking;@Reuters;@CNN;@AP;@guardian;#BreakingNews

# CÔNG NGHỆ & STARTUP (Tech & Startup)
# TWITTER_SOURCES=@TechCrunch;@TheVerge;@WIRED;@VentureBeat;#Technology;#Startup;#AI

# KINH TẾ & TÀI CHÍNH (Business & Finance)
# TWITTER_SOURCES=@business;@WSJ;@Forbes;@CNBC;@FT;#Business;#Finance;#Economy

# CRYPTO & BLOCKCHAIN
# TWITTER_SOURCES=@coindesk;@cointelegraph;@binance;@ethereum;#CryptoCurrency;#Blockchain

# TIN VIỆT NAM (Vietnamese News)
# TWITTER_SOURCES=@VNExpress;@tuoitrenews;@ThanhNienNews;#Vietnam

# AI & MACHINE LEARNING
# TWITTER_SOURCES=@OpenAI;@GoogleAI;@DeepMindAI;@AndrewYNg;#AI;#MachineLearning

# ===== DANH SÁCH SOURCES ĐẦY ĐỦ (Reference) =====
# Uncomment từng cái một nếu cần, KHÔNG uncomment tất cả!
#
# === TIN TỨC QUỐC TẾ ===
# @BBCBreaking, @Reuters, @AP, @CNN, @BBCWorld, @AJEnglish
# @guardian, @nytimes, @washingtonpost, @TIME
#
# === KINH TẾ & TÀI CHÍNH ===
# @business, @WSJ, @Forbes, @FT, @CNBC, @MarketWatch, @TheEconomist
#
# === CÔNG NGHỆ ===
# @TechCrunch, @TheVerge, @WIRED, @verge, @engadget
# @mashable, @techreview, @arstechnica, @VentureBeat, @Recode
#
# === KHOA HỌC & Y TẾ ===
# @nature, @ScienceMagazine, @WHO, @NatGeo, @NASA, @SpaceX
#
# === TIN VIỆT NAM ===
# @VNExpress, @tuoitrenews, @ThanhNienNews, @VietnamnetNews, @VNEconomyNews
#
# === CRYPTO & BLOCKCHAIN ===
# @coindesk, @cointelegraph, @binance, @ethereum, @bitcoin
#
# === AI & MACHINE LEARNING ===
# @OpenAI, @GoogleAI, @DeepMindAI, @AndrewYNg
#
# === HASHTAGS PHỔ BIẾN ===
# #BreakingNews, #Technology, #AI, #MachineLearning, #Startup
# #Business, #Finance, #CryptoCurrency, #Blockchain, #Innovation
# #Science, #Health, #Climate, #Economy, #Politics, #Vietnam
# #Tech, #Programming, #DataScience, #WebDevelopment

# =============================================================================
# Security & Authentication
# =============================================================================

# JWT Configuration
# IMPORTANT: Change JWT_SECRET_KEY to a long random value before deploying!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials (CHANGE BOTH BEFORE DEPLOYING TO PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# =============================================================================
# Google OAuth (optional – enables "Sign in with Google")
# =============================================================================
# 1. Go to https://console.cloud.google.com > APIs & Services > Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add your frontend origin to Authorized JavaScript origins
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# Frontend (Vite) – copy relevant vars to web/.env or web/.env.local
# =============================================================================

# URL of the FastAPI backend visible to the browser (no trailing slash)
VITE_API_URL=http://localhost:8000

# For production deployment set this to your actual backend URL, e.g.:
# VITE_API_URL=https://api.yourdomain.com

# API Key for external clients (optional)
# API_KEY=your-api-key-here

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
