# URL của backend trên Render (thay bằng URL thực sau khi deploy)
# Ví dụ: https://newsbot-api.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com

# Google OAuth Client ID (tùy chọn – để bật nút "Đăng nhập bằng Google")
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
